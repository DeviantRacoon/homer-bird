# ==============================================================================
# Homer Bird - Client Environment Variables (.env)
# ==============================================================================

# URL de la API REST del backend
# En desarrollo local: /api (gestionado automáticamente por el proxy de Vite)
# En producción: https://homer-bird-server.onrender.com/api
VITE_API_URL=/api

# URL del Servidor WebSocket (para salas multijugador en tiempo real)
# En desarrollo local: ws://localhost:3001
# En producción: wss://homer-bird-server.onrender.com
VITE_WS_URL=ws://localhost:3001

# [Opcional] URL base única del backend. Si se define, el cliente deduce automáticamente la API y el WebSocket
# VITE_BACKEND_URL=https://homer-bird-server.onrender.com
