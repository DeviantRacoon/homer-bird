# ==============================================================================
# Homer Bird - Server Environment Variables (.env)
# ==============================================================================

# Entorno de ejecución (development | production)
NODE_ENV=development

# Puerto del servidor HTTP y WebSockets (por defecto 3001 o $PORT en Render/Railway)
PORT=3001

# Orígenes CORS permitidos (usar '*' para permitir todos o URLs separadas por comas)
# Ej: http://localhost:5173,https://homer-bird.netlify.app
CORS_ORIGIN=*

# Base de Datos y Leaderboards (Redis)
# En local con Docker: redis://localhost:6379
# En producción: redis://default:password@host:port (Upstash, Redis Cloud, Railway)
# (Si se deja en blanco o no está disponible, conmuta automáticamente a fallback JSON)
REDIS_URL=redis://localhost:6379

# Persistencia de Respaldo Local (cuando Redis no esté conectado)
DATA_DIRECTORY=./data

# Seguridad y Anti-Cheat
ANTI_CHEAT_ENABLED=true
MAX_PLAYERS_PER_ROOM=20
