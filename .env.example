# ==============================================================================
# Homer Bird • Configuración de Entorno (Plantilla de Ejemplo)
# ==============================================================================

NODE_ENV=development
SERVER_PORT=3001

# URL del Backend para producción (Render, Railway, Fly.io, etc.)
# En Netlify / Vercel, agrega esta variable en tus Environment Variables si tu backend está alojado en otro servidor:
# VITE_BACKEND_URL=https://homer-bird-server.onrender.com

VITE_API_URL=/api
ANTI_CHEAT_ENABLED=true
MAX_PLAYERS_PER_ROOM=20
STORAGE_DRIVER=json
DATA_DIRECTORY=./data
